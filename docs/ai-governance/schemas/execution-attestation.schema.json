{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jboot.dev/schemas/execution-attestation.schema.json",
  "title": "JBoot AI engineering execution attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_id", "date", "mode", "status", "runtime",
    "model", "revision", "target_project", "target_module", "scope_paths",
    "instruction_sources", "instruction_set_sha256", "context_sha256", "agents", "skills",
    "human_approval", "security_review", "measurements", "validations", "result"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "execution_id": {"type": "string", "minLength": 8},
    "date": {"type": "string", "format": "date"},
    "mode": {"enum": ["planning", "architecture", "implementation", "review", "governance"]},
    "status": {"enum": ["success", "failed", "partial", "blocked"]},
    "runtime": {"type": "string"},
    "model": {"type": "string"},
    "revision": {"type": "string"},
    "target_project": {"type": "string"},
    "target_module": {"type": ["string", "null"]},
    "scope_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "instruction_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "instruction_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "agents": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "items": {"type": "string"}},
    "human_approval": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["not_required", "approved", "pending", "rejected"]},
        "evidence": {"type": "string"}
      }
    },
    "security_review": {
      "type": "object",
      "required": ["status", "evidence", "open_items"],
      "properties": {
        "status": {"enum": ["passed", "not_applicable", "blocked"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "open_items": {"type": "integer", "minimum": 0}
      }
    },
    "measurements": {
      "type": "object",
      "required": ["status", "prompt_tokens", "completion_tokens", "cost", "latency_ms"],
      "properties": {
        "status": {"enum": ["measured", "not_exposed", "not_collected", "not_applicable"]},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost": {"type": ["number", "null"], "minimum": 0},
        "latency_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "validations": {"type": "array", "items": {"type": "string"}},
    "result": {"type": "string"}
  }
}
