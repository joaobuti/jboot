# Application
APP_ENV=local
APP_NAME=JBoot

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# AI defaults
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Observability
LOG_LEVEL=info
AI_TRACE_ENABLED=true

# Runtime versions
GO_VERSION=1.25.0
FLUTTER_CHANNEL=stable

# Docker image tags
POSTGRES_IMAGE=pgvector/pgvector:pg18
MONGODB_IMAGE=mongo:8.0
VALKEY_IMAGE=valkey/valkey:8-alpine
RABBITMQ_IMAGE=rabbitmq:4-management
TEMPORAL_IMAGE=temporalio/auto-setup:latest
TEMPORAL_UI_IMAGE=temporalio/ui:latest
REDPANDA_IMAGE=redpandadata/redpanda:latest
MINIO_IMAGE=quay.io/minio/minio:latest
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:latest
QDRANT_IMAGE=qdrant/qdrant:latest

# App ports
# Portas publicadas no host. Se alguma estiver ocupada por outro projeto,
# sobrescreva aqui: NEXT_PUBLIC_JBOOT_IDENTITY_API_URL, NEXT_PUBLIC_JBOOT_PLATFORM_API_URL
# e CORS_ORIGINS sao derivadas destas variaveis no docker-compose.yml e
# acompanham a mudanca sozinhas. Nao fixe URL ou origem em valor literal.
JBOOT_NEXT_PORT=3000
JBOOT_VITE_PORT=5173
JBOOT_API_PORT=8000
JBOOT_JURIDICO_DATA_PORT=8030
JBOOT_LARAVEL_PORT=8080
JBOOT_EXPO_PORT=19000
JBOOT_EXPO_DEVTOOLS_PORT=19002
JBOOT_IDENTITY_DATABASE_URL=postgresql://jboot:jboot@postgres:5432/jboot_identity
JBOOT_KANBAN_DATABASE_URL=postgresql://jboot:jboot@postgres:5432/jboot_kanban_demo_dev

# Juridico official data (never commit real values)
# Excecao: a chave abaixo e a chave PUBLICA do DataJud, divulgada pelo proprio
# CNJ em https://datajud-wiki.cnj.jus.br/api-publica/acesso. Nao e segredo.
# O default no codigo continua vazio (config.py), por contrato.
JURIDICO_DATA_DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
JBOOT_PLATFORM_SERVICE_CLIENT_SECRET=
JBOOT_IDENTITY_PLATFORM_SERVICE_CLIENT_SECRET=
JBOOT_IDENTITY_JURIDICO_WORKER_SERVICE_CLIENT_SECRET=
JBOOT_JURIDICO_WORKER_SERVICE_CLIENT_SECRET=
JBOOT_JURIDICO_WORKER_INTERNAL_SECRET=
JBOOT_JURIDICO_MONITOR_ENCRYPTION_KEY=
JBOOT_JURIDICO_MONITOR_ENCRYPTION_KEY_VERSION=1
JBOOT_IDENTITY_JWT_SECRET=
# Conector Claude do Flow: vazios = derivados das portas no docker-compose.
# Em producao: https://auth.<dominio>, https://app.<dominio>/oauth/consentimento
# e https://apinode.<dominio>/kanban/mcp (alcancaveis pelo egress 160.79.104.0/21).
JBOOT_IDENTITY_OAUTH_ISSUER_URL=
JBOOT_IDENTITY_OAUTH_CONSENT_URL=
JBOOT_FLOW_CONNECTOR_RESOURCE_URL=
# Opcionais: hosts de documento CIMD aceitos e redirects permitidos (csv).
JBOOT_IDENTITY_OAUTH_CIMD_ALLOWED_HOSTS=claude.ai
JBOOT_IDENTITY_OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost/callback,http://127.0.0.1/callback
JBOOT_JURIDICO_DATA_AUDIT_HMAC_KEY=
JBOOT_JURIDICO_DATA_AUDIT_HMAC_KEY_VERSION=1

# PostgreSQL + pgvector
POSTGRES_DB=jboot
POSTGRES_USER=jboot
POSTGRES_PASSWORD=jboot
POSTGRES_PORT=5432

# MongoDB
MONGO_INITDB_ROOT_USERNAME=jboot
MONGO_INITDB_ROOT_PASSWORD=jboot
MONGODB_PORT=27017

# Valkey
VALKEY_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=jboot
RABBITMQ_DEFAULT_PASS=jboot
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Temporal
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088

# Redpanda
REDPANDA_PORT=19092
REDPANDA_ADMIN_PORT=9644

# MinIO
MINIO_ROOT_USER=jboot
MINIO_ROOT_PASSWORD=jbootsecret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit (SMTP fake dev-only, usado pelo MailerService do motor de automacao
# por coluna do Kanban/Flow — Sprint 8). Nunca envia e-mail de verdade; UI de
# inspecao em http://localhost:${MAILPIT_UI_PORT}.
MAILPIT_IMAGE=axllent/mailpit:latest
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=flow@jboot.local

# ClickHouse
CLICKHOUSE_DB=jboot
CLICKHOUSE_USER=jboot
CLICKHOUSE_PASSWORD=jboot
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# PJe / DJEN (Comunica PJe - CNJ)
# A consulta de comunicacoes e publica e nao usa credenciais.
# Estas variaveis existem apenas para o seed de dev do portal `pje`
# (make juridico-pje-seed-credentials). Nunca commitar valores reais.
JURIDICO_PJE_DEV_EMAIL=
JURIDICO_PJE_DEV_PASSWORD=

# Payments / InfinitePay Checkout Pix
JBOOT_PAYMENTS_PORT=8040
PAYMENTS_PROVIDER_TIMEOUT=8s
PAYMENTS_INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
# Deve ser uma URL HTTPS publica para callback real; localhost serve apenas ao runtime local.
PAYMENTS_PUBLIC_BASE_URL=http://localhost:8040

# Flow CRM de leads (Sprint 6): conversor .docx -> PDF (Gotenberg, ADR 014 Decisao 2).
# Container `gotenberg` (profile `pdf`) so na rede interna `jboot-pdf-internal`,
# sem porta publicada. Usuario/senha valem para os dois lados (basic auth do
# Gotenberg e cliente do platform-api). Valores abaixo sao SO de dev; o segredo
# real fica no mecanismo de segredos do deploy, nunca no git.
JBOOT_PDF_CONVERTER_URL=http://gotenberg:3000
JBOOT_PDF_CONVERTER_USER=jboot-pdf
JBOOT_PDF_CONVERTER_PASSWORD=dev-only-jboot-pdf-secret-change-before-production

# Flow > Google Drive (por cliente). Credenciais do app OAuth unico do JBoot no
# Google Cloud (cliente "Aplicativo da Web"; redirect URI:
# http://localhost:3002/flow/configuracoes/google-drive; escopos drive.file,
# openid, email; Picker API ativada). Nunca e do usuario final.
JBOOT_FLOW_DRIVE_OAUTH_CLIENT_ID=
JBOOT_FLOW_DRIVE_OAUTH_CLIENT_SECRET=
JBOOT_FLOW_DRIVE_PICKER_API_KEY=
# Numero do projeto no Google Cloud (usado como appId do Picker).
JBOOT_FLOW_DRIVE_PICKER_APP_ID=
# Chave de cifra dos refresh tokens; em producao use secret manager.
JBOOT_FLOW_DRIVE_ENCRYPTION_KEY=
