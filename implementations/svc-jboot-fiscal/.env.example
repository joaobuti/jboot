APP_NAME="svc-jboot-fiscal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=jboot-postgres
DB_PORT=5432
DB_DATABASE=jboot_fiscal
DB_USERNAME=jboot
DB_PASSWORD=jboot

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Chave mestra AES-256-GCM para criptografia de certificados A1
# Gerar: openssl rand -hex 32
# Em producao: injetar via secret manager, nunca commitar valor real
FISCAL_CERT_ENCRYPTION_KEY=

# Identity Hub — JWKS endpoint para validacao de JWT s2s
IDENTITY_HUB_JWKS_URL=http://bff-jboot-identity:8000/.well-known/jwks.json

# Identificador deste servico no claim 'aud' do JWT s2s
FISCAL_SERVICE_AUDIENCE=svc:fiscal

# Ambiente SEFAZ padrao (homologacao | producao)
SEFAZ_AMBIENTE_PADRAO=homologacao

# Timeout e retry para chamadas SEFAZ
SEFAZ_TIMEOUT_MS=30000
SEFAZ_TIMEOUT_PER_ATTEMPT_MS=10000
SEFAZ_RETRY_MAX=3
SEFAZ_RETRY_BACKOFF_BASE_MS=1000

# Alerta de certificado prestes a expirar (dias)
CERT_ALERT_DAYS_BEFORE=30
