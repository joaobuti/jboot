PDV_PORT=8010
JBOOT_PDV_DATABASE_URL=postgresql://jboot:jboot@postgres:5432/jboot_pdv
JBOOT_IDENTITY_DATABASE_URL=postgresql://jboot:jboot@postgres:5432/jboot_identity
JBOOT_JURIDICO_DATABASE_URL=postgresql://jboot:jboot@postgres:5432/jboot_juridico_advocacia_dev
JBOOT_KANBAN_DATABASE_URL=postgresql://jboot:jboot@postgres:5432/jboot_kanban_demo_dev
JBOOT_IDENTITY_JWT_SECRET=change-this-dev-secret-with-at-least-32-characters
JBOOT_JURIDICO_WORKER_URL=http://localhost:8020
JBOOT_KANBAN_ATTACHMENTS_BUCKET=kanban-card-attachments

# Broker BullMQ do motor de automacao por coluna do Kanban/Flow (Sprint 8).
REDIS_URL=redis://valkey:6379

# SMTP generico (nodemailer) do MailerService do motor de automacao por
# coluna do Kanban/Flow (Sprint 8). Em dev aponta para o Mailpit do
# docker-compose.yml (sem auth, sem TLS).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=flow@jboot.local

JBOOT_FISCAL_SERVICE_URL=http://localhost:8090
JBOOT_FISCAL_INTERNAL_SECRET=dev-only-fiscal-internal-secret-change-in-production

# Modulo comanda (autoatendimento publico via QR de mesa) — dois segredos
# JWT independentes entre si e do JBOOT_IDENTITY_JWT_SECRET, nunca
# compartilhados. Ver modules/comanda/MODULE_CONTRACT.md.
JBOOT_COMANDA_QR_SECRET=change-this-dev-comanda-qr-secret-with-32-chars
JBOOT_COMANDA_SESSION_SECRET=change-this-dev-comanda-session-secret-32-chars

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
