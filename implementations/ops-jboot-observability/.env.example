OBS_ENVIRONMENT=local
OBS_TENANT_ID=jboot-local
# Endereço da bridge Docker alcançável como host.docker.internal pelos containers.
OBS_DOCKER_GATEWAY_ADDRESS=172.17.0.1

# Substitua antes do primeiro uso. Nunca versione o arquivo .env real.
OBS_MINIO_ROOT_USER=replace-with-local-user
OBS_MINIO_ROOT_PASSWORD=replace-with-long-random-password
OBS_POSTGRES_USER=observability
OBS_POSTGRES_PASSWORD=replace-with-long-random-password
OBS_GRAFANA_ADMIN_USER=admin
OBS_GRAFANA_ADMIN_PASSWORD=replace-with-long-random-password
