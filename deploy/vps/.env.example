# Modelo do /opt/jboot/.env do VPS de producao (docker-compose.prod.yml).
# O arquivo real nunca entra no git e fica com permissao 600, dono deploy.
#
# Gerar segredos aleatorios:  openssl rand -hex 32
# Use HEX (sem / + @ :) em senhas que entram em URL de conexao (POSTGRES_PASSWORD).
# Gerar hash bcrypt de senha de login: ver docker/postgres/prod/010_identity_credentials.sql.

# --- Imagens -----------------------------------------------------------------
JBOOT_REGISTRY=registry.gitlab.com/<grupo>/<projeto>
# Tag padrao de todas as imagens; cada servico pode sobrescrever com <SERVICO>_TAG
JBOOT_TAG=
# IDENTITY_API_TAG= IDENTITY_ADMIN_TAG= PLATFORM_API_TAG= PLATFORM_WEB_TAG=
# AI_GATEWAY_TAG= PAYMENTS_TAG= JURIDICO_DATA_TAG= JURIDICO_WORKER_TAG=
# LANDING_TAG= PORTFOLIO_TAG= MIGRATE_TAG=

# --- Hosts publicos (registro A de cada um na Configr -> IP do VPS) ----------
JBOOT_ACME_EMAIL=
# local_certs = CA interna do Caddy (validacao antes da virada de DNS);
# vazio = Let's Encrypt
JBOOT_CADDY_TLS_MODE=
JBOOT_LANDING_HOST=jboot.com.br
JBOOT_PORTFOLIO_HOST=portfolio.jboot.com.br
JBOOT_APP_HOST=app.jboot.com.br
JBOOT_ADMIN_HOST=admin.jboot.com.br
JBOOT_AUTH_HOST=auth.jboot.com.br
JBOOT_PLATFORM_API_HOST=apinode.jboot.com.br
JBOOT_AI_API_HOST=ai-api.jboot.com.br
JBOOT_PAYMENTS_HOST=payments-api.jboot.com.br
JBOOT_FILES_HOST=files.jboot.com.br
# Origens do navegador aceitas pelas APIs (sem barra no fim)
CORS_ORIGINS=https://app.jboot.com.br,https://admin.jboot.com.br

# --- Infra -------------------------------------------------------------------
POSTGRES_USER=jboot
POSTGRES_PASSWORD=
MINIO_ROOT_USER=jboot
MINIO_ROOT_PASSWORD=
JBOOT_PDF_CONVERTER_USER=jboot-pdf
JBOOT_PDF_CONVERTER_PASSWORD=

# --- Credenciais iniciais (aplicadas pelo job migrate a cada deploy) --------
# Hash bcrypt SEMPRE entre aspas simples: sem elas o compose interpreta os `$`
# do hash como variaveis. Validado em 2026-11-13 (login real com o hash).
JBOOT_PROD_SENIOR_EMAIL=
JBOOT_PROD_SENIOR_PASSWORD_HASH='$2b$12$...'
JBOOT_PROD_DEMO_PASSWORD_HASH='$2b$12$...'

# --- Identity ----------------------------------------------------------------
JBOOT_IDENTITY_JWT_SECRET=
JBOOT_ACCESS_TOKEN_TTL_SECONDS=50400
# Pares s2s: o mesmo valor vai para o Identity e para o servico chamador
JBOOT_PLATFORM_SERVICE_CLIENT_SECRET=
JBOOT_JURIDICO_WORKER_SERVICE_CLIENT_SECRET=

# --- Platform ----------------------------------------------------------------
JBOOT_USER_PROVISIONING_HMAC_KEY=
JBOOT_JURIDICO_WORKER_INTERNAL_SECRET=
JBOOT_JURIDICO_MONITOR_ENCRYPTION_KEY=
JBOOT_JURIDICO_MONITOR_ENCRYPTION_KEY_VERSION=1
JBOOT_JURIDICO_DATA_AUDIT_HMAC_KEY=
JBOOT_JURIDICO_DATA_AUDIT_HMAC_KEY_VERSION=1
JBOOT_COMANDA_QR_SECRET=
JBOOT_COMANDA_SESSION_SECRET=
JBOOT_FLOW_DRIVE_ENCRYPTION_KEY=
JBOOT_FLOW_DRIVE_OAUTH_CLIENT_ID=
JBOOT_FLOW_DRIVE_OAUTH_CLIENT_SECRET=
JBOOT_FLOW_DRIVE_PICKER_API_KEY=
JBOOT_FLOW_DRIVE_PICKER_APP_ID=

# --- AI Gateway --------------------------------------------------------------
# 32 bytes em base64: openssl rand -base64 32
AI_GATEWAY_ENCRYPTION_KEY_BASE64=
AI_GATEWAY_ENCRYPTION_KEY_VERSION=1
AI_GATEWAY_EXECUTION_ENABLED=false
AI_GATEWAY_ENABLED_PROVIDERS=openai
AI_GATEWAY_OPENAI_ALLOWED_MODELS=
AI_GATEWAY_OPENAI_TEXT_MODELS=
AI_GATEWAY_OPENAI_STRUCTURED_MODELS=
AI_GATEWAY_ANTHROPIC_ALLOWED_MODELS=
AI_GATEWAY_ANTHROPIC_TEXT_MODELS=
AI_GATEWAY_ANTHROPIC_STRUCTURED_MODELS=

# --- Juridico ----------------------------------------------------------------
JURIDICO_DATA_DATAJUD_API_KEY=

# --- E-mail (convite, esqueci a senha, automacoes do Flow) -------------------
# SMTP da Configr (Q5): SMTP_HOST=smtp.jboot.com.br, porta 587, STARTTLS.
# Vazio = envio desligado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Observabilidade (stack ops-jboot-observability, compose proprio) ----------
# URL base do OTLP/HTTP do stack de observabilidade (rede jboot-observability);
# cada servico acrescenta /v1/traces e /v1/metrics. Vazio desliga a telemetria.
JBOOT_OTLP_HTTP_ENDPOINT=http://otel-gateway:4318
